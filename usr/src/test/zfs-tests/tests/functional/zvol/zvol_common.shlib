. $STF_SUITE/include/libtest.shlib
. $STF_SUITE/tests/functional/zvol/zvol.cfg

#
# Create a simple zvol volume
#
# Where disk_device: is the name of the disk to be used
#       volume_size: is the size of the volume, e.g. 2G
#
function default_zvol_setup # disk_device volume_size
{
        typeset disk=$1
        typeset size=$2
	typeset savedumpdev
	typeset -i output

        create_pool $TESTPOOL "$disk"

        log_must zfs create -V $size $TESTPOOL/$TESTVOL
}

#
# Destroy the default zvol which was setup using
# default_zvol_setup().
#
function default_zvol_cleanup
{
        if datasetexists $TESTPOOL/$TESTVOL ; then
		log_must zfs destroy $TESTPOOL/$TESTVOL
	fi

        destroy_pool $TESTPOOL
}

function get_dumpdevice
{
	typeset ret=$(dumpadm | grep "Dump device:" | awk '{print $3}')
	echo $ret
}

function set_dumpsize
{
	typeset volume=$1

	if [[ -z $volume ]] ; then
		log_note "No volume specified."
		return 1
	fi

	output=$(dumpadm -epH)

	(( output = ceil(output / 1024.0 / 1024.0) ))
	(( output = output + output / 5 ))
	log_must zfs set volsize=${output}m $volume

	return 0
}

function safe_dumpadm
{
	typeset device=$1

	if [[ -z $device || $device == "none" ]] ; then
		log_note "No dump device volume specified."
		return 1
	fi
	if [[ $device == "/dev/zvol/dsk/"* ]] ; then
		typeset volume=${device#/dev/zvol/dsk/}
		set_dumpsize $volume
		log_must dumpadm -d $device
	else
		log_must swapadd
		if ! is_swap_inuse $device ; then
			log_must swap -a $device
		fi
		log_must dumpadm -d swap
	fi
}

function is_zvol_dumpified
{
	typeset volume=$1

	if [[ -z $volume ]] ; then
		log_note "No volume specified."
		return 1
	fi

	zdb -dddd $volume 2 | grep "dumpsize" > /dev/null 2>&1
	return $?
}

function is_swap_inuse
{
	typeset device=$1

	if [[ -z $device ]] ; then
		log_note "No device specified."
		return 1
	fi

	swap -l | awk 'NR > 1 { print $1 }' | \
	    grep "^$device\$" > /dev/null 2>&1
	return $?
}

#
# Log the raw zvol zero thread's recent zfs_dbgmsg entries: the block size
# it is using and whether it found gang blocks and started over.  Each
# restart rewrites the whole volume at half the block size, so a low
# metaslab_force_ganging makes initialization many times slower.
#
function log_raw_zvol_dbgmsg
{
	typeset line

	log_note "metaslab_force_ganging is" \
	    "$(get_tunable metaslab_force_ganging)"
	mdb -k -e ::zfs_dbgmsg | grep -E "^zv |zvol_zero|gang blocks" | \
	    tail -20 | while read -r line; do
		log_note "$line"
	done
}

#
# Run a raw zvol ioctl on device $2.  "status" prints the initialization
# status: 0, or an errno name (EINPROGRESS while it is running).  "stop"
# stops the initialization and waits for it to exit.
#
function rawvol_ioctl # <status|stop> <device>
{
	python -c '
import errno, fcntl, os, struct, sys
DKIOCRAWVOLSTATUS = (0x04 << 8) | 30
DKIOCRAWVOLSTOP = (0x04 << 8) | 31
fd = os.open(sys.argv[2], os.O_RDONLY)
if sys.argv[1] == "stop":
	fcntl.ioctl(fd, DKIOCRAWVOLSTOP, 0)
else:
	# drs_vers, drs_status, drs_zoff, drs_len
	drs = fcntl.ioctl(fd, DKIOCRAWVOLSTATUS, bytes(24))
	status = struct.unpack("=IiQQ", drs)[1]
	print(errno.errorcode.get(status, status) if status != 0 else 0)
' "$@"
}

#
# Wait for the initialization of raw zvol device $1 to finish, and verify
# that it succeeded.
#
function rawvol_wait_init # <device>
{
	typeset -i tries=0
	while [[ $(rawvol_ioctl status $1) == EINPROGRESS ]]; do
		((tries++ < 120)) || \
		    log_fail "initialization of $1 did not finish"
		sleep 1
	done
	log_must test "$(rawvol_ioctl status $1)" = 0
}

#
# Stop the initialization of raw zvol device $1 and wait for it to exit, so
# that it no longer holds the zvol open.
#
function rawvol_stop_init # <device>
{
	log_must rawvol_ioctl stop $1
}

#
# Destroy a raw zvol.  Its zero thread keeps it open until initialization
# stops, so stop the initialization first.  The zero thread closes the zvol
# just after DKIOCRAWVOLSTOP returns, so "zfs destroy" can still briefly fail
# with EBUSY.
#
function destroy_raw_zvol # dataset
{
	typeset vol=$1
	typeset -i tries=0

	zinject -c all >/dev/null
	datasetexists $vol || return 0
	rawvol_stop_init /dev/zvol/rdsk/$vol
	while ! zfs destroy $vol 2>/dev/null; do
		if (( ++tries >= 30 )); then
			log_raw_zvol_dbgmsg
			log_must zfs destroy $vol
		fi
		sleep 1
	done
	return 0
}

# Issue DKIOCFREE on a device for one or more extents, each given as a
# start and a length in bytes.  dfl_offset is the -o argument, or 0.  If
# the ioctl fails, exit with its errno.
#
# Usage: dkiocfree [-o offset] <device> <start> <length> [<start> <length>]...
#
function dkiocfree
{
	typeset offset=0 opt

	OPTIND=1
	while getopts "o:" opt; do
		case $opt in
		o)	offset=$OPTARG ;;
		*)	log_fail "dkiocfree: invalid option" ;;
		esac
	done
	shift $((OPTIND - 1))

	python -c '
import fcntl, os, struct, sys
DKIOCFREE = (0x04 << 8) | 50
fd = os.open(sys.argv[1], os.O_RDWR)
exts = [int(a) for a in sys.argv[3:]]
# dfl_flags, dfl_num_exts, dfl_offset, dfl_exts[].{dfle_start,dfle_length}
dfl = struct.pack("=%dQ" % (3 + len(exts)), 0, len(exts) // 2,
    int(sys.argv[2]), *exts)
try:
	fcntl.ioctl(fd, DKIOCFREE, dfl)
except OSError as e:
	sys.exit(e.errno)
' "$1" $offset "${@:2}"
}
